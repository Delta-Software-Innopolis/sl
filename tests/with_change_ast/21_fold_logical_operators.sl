routine main() =
    var a : boolean = true and false
    var b : boolean = true or false
    var c : boolean = not true
    var d : boolean = true xor true
    if a then
        print_integer(1)
    end
    if b then
        print_integer(2)
    end
    if c then
        print_integer(3)
    end
    if d then
        print_integer(4)
    end
end
